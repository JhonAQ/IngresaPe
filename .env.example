# Variables de entorno de Ingresa.pe
#
# IMPORTANTE: Las variables reales del backend deben configurarse en:
#   .env   (raíz del monorepo)
#
# NestJS / dotenv cargan el archivo desde el directorio de trabajo desde el que
# se ejecuta el servidor. Al usar Nx se corre desde la raíz del monorepo,
# ejemplo:  npx nx serve api
#
# Este archivo (.env.example) es solo una plantilla. Copia su contenido a
# `.env` en la raíz y rellena los valores antes de iniciar el proyecto.
#
# Nunca commitees archivos .env con secretos.

# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/ingresa_db"

# JWT Secret (cambiar en producción; mínimo 32 caracteres)
# Genera uno seguro con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="cambia-esto-por-un-seguro-aleatorio-de-al-menos-32-caracteres"

# OAuth Google
GOOGLE_CLIENT_ID="tu-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# URL del frontend (usada para redirigir tras OAuth)
FRONTEND_URL="http://localhost:4200"

# Redis (códigos OAuth temporales y caché futura)
REDIS_URL="redis://localhost:6379"

# Orígenes permitidos por CORS. Lista separada por comas.
# Si no se define, se usan FRONTEND_URL y orígenes locales por defecto.
# Ejemplo producción:
# CORS_ORIGINS="https://ingresa.pe,https://www.ingresa.pe,https://ingresa.jhonaq.me,https://api.ingresa.pe,https://api.ingresa.jhonaq.me"
CORS_ORIGINS="http://localhost:4200,http://127.0.0.1:4200,http://localhost:3000,http://127.0.0.1:3000"

# Rate limiting global (Express). TTL en milisegundos.
RATE_LIMIT_TTL_MS="60000"
RATE_LIMIT_MAX="100"

# Facebook (opcional)
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
